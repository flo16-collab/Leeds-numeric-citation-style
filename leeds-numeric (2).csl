<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="sort-only" default-locale="en-GB">
  <info>
    <title>Leeds Numeric</title>
    <id>http://www.zotero.org/styles/leeds-numeric</id>
    <link href="http://www.zotero.org/styles/leeds-numeric" rel="self"/>
    <link href="https://library.leeds.ac.uk/info/1402/referencing/51/leeds-numeric-introduction" rel="documentation"/>
    <author>
      <name>University of Leeds (compiled for Mendeley)</name>
    </author>
    <category citation-format="numeric"/>
    <category field="generic-base"/>
    <updated>2026-05-22T00:00:00+00:00</updated>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/">Creative Commons Attribution-ShareAlike 3.0</rights>
  </info>

  <locale xml:lang="en-GB">
    <terms>
      <term name="accessed">Accessed</term>
      <term name="editor" form="short">ed.</term>
      <term name="editors" form="short">eds.</term>
    </terms>
  </locale>

  <macro name="author">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " delimiter=", " delimiter-precedes-last="never" and="text" initialize-with="."/>
      <substitute>
        <names variable="editor">
          <name name-as-sort-order="all" sort-separator=", " delimiter=", " delimiter-precedes-last="never" and="text" initialize-with="."/>
          <label form="short" prefix=" "/>
        </names>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="chapter-editor">
    <names variable="editor">
      <name name-as-sort-order="all" sort-separator=", " delimiter=", " delimiter-precedes-last="never" and="text" initialize-with="."/>
      <label form="short" prefix=" "/>
    </names>
  </macro>

  <macro name="year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="day-month">
    <date variable="issued">
      <date-part name="day"/>
      <date-part name="month" prefix=" "/>
    </date>
  </macro>

  <macro name="online-tag">
    <choose>
      <if variable="URL">
        <text value="[Online]"/>
      </if>
    </choose>
  </macro>

  <macro name="access-date">
    <choose>
      <if variable="accessed">
        <group prefix="[" suffix="]">
          <text term="accessed" text-case="capitalize-first" suffix=" "/>
          <date variable="accessed">
            <date-part name="day"/>
            <date-part name="month" prefix=" "/>
            <date-part name="year" prefix=" "/>
          </date>
        </group>
      </if>
    </choose>
  </macro>

  <macro name="url">
    <choose>
      <if variable="URL">
        <text variable="URL" prefix="Available from: "/>
      </if>
    </choose>
  </macro>

  <macro name="pages">
    <choose>
      <if variable="page">
        <text variable="page" prefix="pp."/>
      </if>
    </choose>
  </macro>

  <macro name="publisher">
    <group delimiter=": ">
      <text variable="publisher-place"/>
      <text variable="publisher"/>
    </group>
  </macro>

  <citation collapse="citation-number">
    <sort>
      <key variable="citation-number"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter=", ">
      <text variable="citation-number"/>
      <choose>
        <if variable="locator">
          <group prefix=", ">
            <label variable="locator" form="short"/>
            <text variable="locator"/>
          </group>
        </if>
      </choose>
    </layout>
  </citation>

  <bibliography et-al-min="100" et-al-use-first="99" second-field-align="flush">
    <layout suffix=".">
      <text variable="citation-number" suffix=". "/>
      <choose>
        <if type="article-journal article-magazine" match="any">
          <group delimiter=". ">
            <text macro="author"/>
            <text variable="title"/>
            <group delimiter=". ">
              <text variable="container-title" font-style="italic"/>
              <text macro="online-tag"/>
            </group>
            <group delimiter=", ">
              <text macro="year"/>
              <group>
                <text variable="volume" font-weight="bold"/>
                <text variable="issue" prefix="(" suffix=")"/>
              </group>
              <text macro="pages"/>
            </group>
            <text macro="access-date"/>
            <text macro="url"/>
          </group>
        </if>
        <else-if type="article-newspaper">
          <group delimiter=". ">
            <text macro="author"/>
            <text variable="title"/>
            <group delimiter=". ">
              <text variable="container-title" font-style="italic"/>
              <text macro="online-tag"/>
            </group>
            <group delimiter=", ">
              <text macro="year"/>
              <text macro="day-month"/>
            </group>
            <text macro="access-date"/>
            <text macro="url"/>
          </group>
        </else-if>
        <else-if type="chapter">
          <group delimiter=". ">
            <text macro="author"/>
            <text variable="title"/>
            <group>
              <text value="In: "/>
              <group delimiter=". ">
                <text macro="chapter-editor"/>
                <group delimiter=". ">
                  <text variable="container-title" font-style="italic"/>
                  <text macro="online-tag"/>
                </group>
                <group delimiter=", ">
                  <text macro="publisher"/>
                  <text macro="year"/>
                  <text macro="pages"/>
                </group>
              </group>
            </group>
            <text macro="access-date"/>
            <text macro="url"/>
          </group>
        </else-if>
        <else-if type="paper-conference">
          <group delimiter=". ">
            <text macro="author"/>
            <text variable="title"/>
            <group>
              <text value="In: "/>
              <group delimiter=", ">
                <text variable="container-title" font-style="italic"/>
                <text macro="year"/>
                <text variable="event-place"/>
              </group>
            </group>
            <group delimiter=", ">
              <text macro="publisher"/>
              <text macro="year"/>
              <text macro="pages"/>
            </group>
            <text macro="access-date"/>
            <text macro="url"/>
          </group>
        </else-if>
        <else-if type="report">
          <group delimiter=". ">
            <text macro="author"/>
            <text variable="title" font-style="italic"/>
            <text macro="online-tag"/>
            <group delimiter=", ">
              <text macro="publisher"/>
              <text macro="year"/>
            </group>
            <text macro="access-date"/>
            <text macro="url"/>
          </group>
        </else-if>
        <else-if type="webpage post-weblog post" match="any">
          <group delimiter=". ">
            <text macro="author"/>
            <text variable="title" font-style="italic"/>
            <text macro="online-tag"/>
            <group delimiter=", ">
              <text macro="publisher"/>
              <text macro="year"/>
            </group>
            <text macro="access-date"/>
            <text macro="url"/>
          </group>
        </else-if>
        <else>
          <group delimiter=". ">
            <text macro="author"/>
            <text variable="title" font-style="italic"/>
            <text macro="online-tag"/>
            <group delimiter=", ">
              <text macro="publisher"/>
              <text macro="year"/>
            </group>
            <text macro="access-date"/>
            <text macro="url"/>
          </group>
        </else>
      </choose>
    </layout>
  </bibliography>

</style>
